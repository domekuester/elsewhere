# Required for production canonical URLs, Open Graph URLs, robots.txt and sitemap.xml.
#
# This is the publication's single public root: origin *and* path. astro.config.mjs splits it
# into Astro's `site` and `base`, so a site served from a subpath needs no second variable and
# no hardcoded production URL anywhere in the UI. Every internal link and public asset is
# resolved against it through src/config/paths.ts.
#
#   own domain, served at the root   SITE_URL=https://your-domain.example
#   GitHub Pages project page        SITE_URL=https://domekuester.github.io/elsewhere
#   local development                SITE_URL=http://localhost:4321
SITE_URL=https://your-domain.example

# Public enquiry address. Owner-supplied and verified before launch.
# Without it the Studio, Licensing, Contact and viewer enquiry actions are not rendered
# and those routes are noindexed, rather than shipping a dead form or an invented address.
PUBLIC_CONTACT_EMAIL=

# Public attribution for credits, copyright notices and ImageObject structured data.
# Leave empty to credit the publication itself ("ELSEWHERE") instead of a named person.
PUBLIC_CREATOR_NAME=

# Privacy-conscious analytics. Leave empty to ship no analytics provider at all;
# the internal event bus still runs and simply has no subscriber.
# Provider must be approved by the owner before it is set. See docs/PHASE-9-ANALYTICS.md.
PUBLIC_ANALYTICS_PROVIDER=
PUBLIC_ANALYTICS_DOMAIN=
