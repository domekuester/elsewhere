# Required for production canonical URLs, Open Graph URLs, robots.txt and sitemap.xml.
#
# This is the publication's single public root: origin *and* path. astro.config.mjs splits it
# into Astro's `site` and `base`, so a site served from a subpath needs no second variable and
# no hardcoded production URL anywhere in the UI. Every internal link and public asset is
# resolved against it through src/config/paths.ts.
#
#   own domain, served at the root   SITE_URL=https://your-domain.example
#   GitHub Pages project page        SITE_URL=https://domekuester.github.io/elsewhere
#   local development                SITE_URL=http://localhost:4321
SITE_URL=https://your-domain.example

# Public enquiry address. Owner-supplied and verified before launch.
# Without it the Studio, Licensing, Contact and viewer enquiry actions are not rendered
# and those routes are noindexed, rather than shipping a dead form or an invented address.
PUBLIC_CONTACT_EMAIL=

# Public attribution for credits, copyright notices and ImageObject structured data.
# Leave empty to credit the publication itself ("ELSEWHERE") instead of a named person.
PUBLIC_CREATOR_NAME=

# Photography licensing enquiries (Phase 16A). The Formspree form that receives them.
#
# This is public integration configuration, not a credential: it identifies an endpoint and is
# visible in the page. Set it to the id from your form's endpoint — the <id> in
# https://formspree.io/f/<id> — and the licensing enquiry form goes live. Leave it empty and the
# Licensing page falls back to the plain enquiry link instead of shipping a form that posts nowhere.
# The notification address is configured inside the Formspree dashboard, not here.
PUBLIC_FORMSPREE_LICENSING_FORM_ID=

# Optional override. Unset, licensing submission follows the form id above. Set to `false` to take
# a configured funnel back off the public site without deleting the id; set to `true` to assert
# that it must be live, which makes a missing or malformed form id fail the build rather than
# degrade quietly.
PUBLIC_LICENSING_ENABLED=

# Google Search Console verification, HTML-tag method.
#
# ELSEWHERE is served from a GitHub Pages project path, so a Domain property (DNS verification) is
# not available: github.io DNS is not the owner's. The property is a URL-prefix one rooted at
# https://domekuester.github.io/elsewhere/ and this is the token that verifies it. Public, not a
# credential. Paste only the `content` value from Search Console's HTML-tag method — not the tag.
# Unset, no verification tag is emitted.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Privacy-conscious analytics. Leave empty to ship no analytics provider at all;
# the internal event bus still runs and simply has no subscriber.
# Provider must be approved by the owner before it is set. See docs/PHASE-9-ANALYTICS.md.
PUBLIC_ANALYTICS_PROVIDER=
PUBLIC_ANALYTICS_DOMAIN=
