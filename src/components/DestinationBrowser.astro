---
import destinationData from '../../data/destinations.json';
const order = ['japan', 'la-reunion', 'malaysia', 'thailand', 'phu-quoc', 'laos'];
const destinations = order.map((id) => destinationData.destinations.find((destination) => destination.id === id)).filter(Boolean);
---

<section class="destination-index" id="destinations" aria-labelledby="destination-title">
  <header>
    <span class="memory-mark" aria-hidden="true"></span>
    <h2 id="destination-title">Destinations</h2>
    <p>Place is now a second way through the archive. Assignments come from the owner’s travel timeline; transition days remain outside the destination edit until reviewed.</p>
    <a class="editorial-link" href="/destinations/">Enter the place index <span aria-hidden="true">→</span></a>
  </header>
  <ol>
    {destinations.map((destination, index) => (
      <li>
        <span class="destination-number">{String(index + 1).padStart(2, '0')}</span>
        {destination.publicationStatus === 'published' ? <a href={`/destinations/${destination.slug}/`}><strong>{destination.name}</strong></a> : <strong>{destination.name}</strong>}
        <small>{destination.confirmedPhotoCount} photographs{destination.publicationStatus === 'published' ? ' · chapter open' : ''}</small>
      </li>
    ))}
  </ol>
</section>
