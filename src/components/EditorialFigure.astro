---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  class?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'eager' | 'lazy';
  position?: string;
}

const {
  src, alt, caption, class: className = '',
  widths = [480, 768, 1200, 1800],
  sizes = '(min-width: 900px) 80vw, 100vw',
  loading = 'lazy', position = '50% 50%',
} = Astro.props;
---

<figure class:list={['editorial-figure', className]} style={`--object-position: ${position}`} data-reveal>
  <div class="figure-window">
    <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} decoding="async" />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
