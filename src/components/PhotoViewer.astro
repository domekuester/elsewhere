<dialog class="photo-viewer" data-photo-viewer aria-label="Immersive photograph viewer" tabindex="-1">
  <div class="viewer-stage" data-viewer-stage aria-busy="false">
    <img class="viewer-preview" data-viewer-preview alt="" aria-hidden="true" />
    <img class="viewer-image" data-viewer-image alt="" decoding="async" />
    <span class="viewer-loading" data-viewer-loading role="status">Loading full photograph</span>
  </div>
  <div class="viewer-chrome">
    <a class="viewer-wordmark" href="/">ELSEWHERE</a>
    <p class="viewer-count" aria-live="polite"><span data-viewer-current>01</span> / <span data-viewer-total>00</span></p>
    <button class="viewer-close" type="button" data-viewer-close aria-label="Close photograph">Close <span aria-hidden="true">×</span></button>
    <button class="viewer-nav viewer-previous" type="button" data-viewer-previous aria-label="Previous photograph"><span aria-hidden="true">←</span></button>
    <button class="viewer-nav viewer-next" type="button" data-viewer-next aria-label="Next photograph"><span aria-hidden="true">→</span></button>
    <div class="viewer-caption">
      <i aria-hidden="true"></i>
      <p data-viewer-meta>Archive frame</p>
      <a data-viewer-destination hidden>Open destination <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</dialog>
