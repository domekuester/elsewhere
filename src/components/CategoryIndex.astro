---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { withBase } from '../config/paths';

interface World {
  name: string;
  feeling: string;
  href: string;
  image: ImageMetadata;
  alt: string;
  position?: string;
}

interface Props { worlds: World[] }
const { worlds } = Astro.props;

// The wall is a five-column spread over a three-plate suite: five, six, then four, four, four
// columns of twelve (see `.world-1`…`.world-5`). `sizes` states those widths rather than one
// approximation, so the browser stops fetching a 54vw derivative for a plate drawn at 30vw.
const plateSizes = ['38vw', '46vw', '30vw', '30vw', '30vw'];
// The label leads the plate. A category index should name the door before it shows what is behind
// it, and putting the heading first in the source is also the order a screen reader and a keyboard
// user need: name, entry affordance, description, then the photograph it opens.
---

<section class="worlds" id="explore" aria-labelledby="worlds-title">
  <header class="worlds-heading">
    <p>Explore by visual world</p>
    <h2 id="worlds-title">What<br />remains.</h2>
    <p class="worlds-deck">Five ways in. The archive already knows where these were taken; this is sorted by what is in them.</p>
  </header>

  <div class="worlds-sequence">
    {worlds.map((world, index) => (
      <a class:list={['world', `world-${index + 1}`]} href={withBase(world.href)}>
        <div class="world-label">
          <span class="folio folio-plate">{String(index + 1).padStart(2, '0')}</span>
          <h3>{world.name}</h3>
          <i aria-hidden="true">↗</i>
          <p>{world.feeling}</p>
        </div>
        <div class="world-photo" data-photo-reveal>
          <Image src={world.image} alt={world.alt} widths={[480, 768, 1200, 1600]} sizes={`(min-width: 901px) ${plateSizes[index] ?? '46vw'}, 100vw`} loading="lazy" style={`object-position:${world.position ?? '50% 50%'}`} />
        </div>
      </a>
    ))}
  </div>
</section>
