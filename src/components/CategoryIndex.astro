---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface World {
  name: string;
  feeling: string;
  href: string;
  image: ImageMetadata;
  alt: string;
  position?: string;
}

interface Props { worlds: World[] }
const { worlds } = Astro.props;
---

<section class="worlds" id="explore" aria-labelledby="worlds-title">
  <header class="worlds-heading">
    <p>Explore by visual world</p>
    <h2 id="worlds-title">What<br />remains.</h2>
    <p class="worlds-deck">Five ways into an archive. Not where a photograph was taken, but what it held.</p>
  </header>

  <div class="worlds-sequence">
    {worlds.map((world, index) => (
      <a class:list={['world', `world-${index + 1}`]} href={world.href}>
        <div class="world-photo" data-photo-reveal>
          <Image src={world.image} alt={world.alt} widths={[480, 768, 1200, 1600]} sizes={index === 4 ? '(min-width: 901px) 64vw, 100vw' : '(min-width: 901px) 45vw, 100vw'} loading="lazy" style={`object-position:${world.position ?? '50% 50%'}`} />
        </div>
        <div class="world-label">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h3>{world.name}</h3>
          <p>{world.feeling}</p>
          <i aria-hidden="true">↗</i>
        </div>
      </a>
    ))}
  </div>
</section>
