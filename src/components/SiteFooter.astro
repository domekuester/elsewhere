---
import { site } from '../config/site';
const { archiveHref = '/archive/' } = Astro.props;
const navigation = site.navigation.map((item) => item.href === '/archive/' ? { ...item, href: archiveHref } : item);
---

<footer class="site-footer" id="about">
  <a class="footer-continuation" href={archiveHref} data-analytics-event="archive_open" data-analytics-context="footer">
    <span>Enter the archive</span><b aria-hidden="true">→</b>
  </a>
  <div class="footer-base">
    <a class="footer-wordmark" href="/#main">{site.name}</a>
    <p>A visual archive of the world as experienced by one person.</p>
    <nav aria-label="Footer">{navigation.map((item) => <a href={item.href} data-analytics-event="navigation_open" data-analytics-context={`footer:${item.label.toLowerCase()}`}>{item.label}</a>)}</nav>
    <small>Original photography throughout.</small>
  </div>
</footer>
