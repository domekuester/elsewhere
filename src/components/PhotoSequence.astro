---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Photo { image: ImageMetadata; alt: string; note: string; position?: string }
interface Props { photos: Photo[] }
const { photos } = Astro.props;

// Three, four and five columns of twelve above 1200px, three equal quarters below it — see
// `.closing-photo-1`…`-3`. The mobile widths mirror the same rising close.
const plateSizes = [
  { wide: '22vw', mid: '30vw', small: '62vw' },
  { wide: '30vw', mid: '30vw', small: '78vw' },
  { wide: '38vw', mid: '30vw', small: '94vw' },
];
const plate = (index) => plateSizes[index] ?? plateSizes[plateSizes.length - 1];
---

<section class="closing-sequence" id="archive" aria-labelledby="archive-title">
  <header>
    <span class="memory-mark" aria-hidden="true"></span>
    <h2 id="archive-title">The archive is<br />always unfinished.</h2>
    <p>More photographs. More relationships. Fewer conclusions.</p>
  </header>
  <div class="closing-photos">
    {photos.map((photo, index) => (
      <figure class={`closing-photo closing-photo-${index + 1}`}>
        <div data-photo-reveal><Image src={photo.image} alt={photo.alt} widths={[480, 768, 1200, 1600]} sizes={`(min-width: 1201px) ${plate(index).wide}, (min-width: 901px) ${plate(index).mid}, ${plate(index).small}`} loading="lazy" style={`object-position:${photo.position ?? '50% 50%'}`} /></div>
        <figcaption><span class="folio folio-lead">{String(index + 1).padStart(2, '0')}</span><span>{photo.note}</span></figcaption>
      </figure>
    ))}
  </div>
</section>
