---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import vendor from '../../assets/photos/people-vendor.jpg';
import motorcycle from '../../assets/photos/people-motorcycle.jpg';
import goldenPortrait from '../../assets/photos/golden-portrait.jpg';
---

<BaseLayout title="People and encounters — Elsewhere" description="Encounters, gestures, work, and human presence from the Elsewhere visual archive." image="/social/people.jpg" imageAlt="A food vendor works behind a small counter">
  <SiteHeader />
  <main id="main" class="people-page">
    <header class="people-hero">
      <div class="people-hero-copy">
        <span class="memory-mark" aria-hidden="true"></span>
        <h1>People I met<br />along the way.</h1>
        <p>Not a directory of portraits. A record of attention: work, movement, conversation, and the brief permission of a photograph.</p>
      </div>
      <Image src={vendor} alt="A food vendor works behind a small counter" widths={[768, 1200, 1800]} sizes="(min-width: 901px) 58vw, 100vw" loading="eager" fetchpriority="high" />
    </header>

    <section class="encounter-sequence" aria-labelledby="encounter-title">
      <header><h2 id="encounter-title">Encounters,<br />not profiles.</h2><p>Names and places will appear only when known and appropriate. Until then, the photograph remains without invented biography.</p></header>
      <figure class="encounter encounter-worker" data-photo-reveal><img src="/assets-derived/thumbnails/0045-IMG_8992.jpg" srcset="/assets-derived/thumbnails/0045-IMG_8992.jpg 720w, /assets-derived/archive/0045-IMG_8992.jpg 1350w" sizes="(min-width: 901px) 38vw, 88vw" width="2994" height="3992" alt="A seated craftsperson works beside a window" loading="lazy" decoding="async" /><figcaption>Work · Thailand</figcaption></figure>
      <figure class="encounter encounter-vendor" data-photo-reveal><Image src={goldenPortrait} alt="A young woman turns towards low evening light" widths={[480, 768, 1000]} sizes="(min-width: 901px) 25vw, 68vw" loading="lazy" /><figcaption>Last light · La Réunion</figcaption></figure>
      <figure class="encounter encounter-motorcycle" data-photo-reveal><Image src={motorcycle} alt="Two people pause beside a motorcycle on a city street" widths={[768, 1200, 1600]} sizes="(min-width: 901px) 56vw, 100vw" loading="lazy" /><figcaption>Between one place and the next</figcaption></figure>
    </section>

    <aside class="people-next"><p>Another way through the same archive.</p><a href="/collections/black-and-white/"><span>Black &amp; White</span><b aria-hidden="true">→</b></a></aside>
  </main>
  <SiteFooter />
</BaseLayout>
