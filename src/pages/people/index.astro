---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import vendor from '../../assets/photos/people-vendor.jpg';
import motorcycle from '../../assets/photos/people-motorcycle.jpg';
import goldenPortrait from '../../assets/photos/golden-portrait.jpg';
import catalogData from '../../data/photo-catalog';
import { peopleEncounterFrame, peopleEncounters } from '../../data/surface-photos';
import { imageObject, breadcrumbs } from '../../data/image-schema';
import { withBase } from '../../config/paths';

// People sat behind a main-navigation entry with three photographs in it. These six are drawn from
// the frames a full visual review of the archive marked as being *about* a person — not merely
// containing one — and none of them appears anywhere else on the site.
// The selection itself lives in src/data/surface-photos.ts, so /sitemap-images.xml declares the
// same frames this page renders rather than a copy of the list that can fall behind it.
const photosById = new Map(catalogData.photos.map((photo) => [photo.id, photo]));
const resolve = (id, surface) => {
  const photo = photosById.get(id);
  if (!photo?.public) throw new Error(`People selection references ${id} (${surface}), which is not a public photograph.`);
  return photo;
};
const deeper = peopleEncounters.map((entry) => ({ ...resolve(entry.id, 'further encounters'), ...entry }));
const craftsperson = resolve(peopleEncounterFrame.id, 'encounter sequence');
const peopleCount = catalogData.photos.filter((photo) => photo.visualWorlds.includes('people')).length;
const derivativeWidth = (photo, longEdge) => Math.min(photo.width, photo.orientation === 'portrait' ? Math.round(longEdge * photo.width / photo.height) : longEdge);
// Desktop widths follow the plate each role is given in `.people-deeper-grid`: five, five, six,
// four, five and seven columns of twelve.
const deeperPlate = { gesture: '38vw', proximity: '38vw', threshold: '46vw', environment: '30vw', intimate: '38vw', closing: '54vw' };
const deeperSizes = (role) => `(min-width: 901px) ${deeperPlate[role] ?? '38vw'}, (min-width: 561px) ${['threshold', 'closing'].includes(role) ? '58vw' : '48vw'}, ${['threshold', 'closing'].includes(role) ? '100vw' : '86vw'}`;
// Only the archive derivatives this page actually renders carry ImageObject markup. The hero and
// the two colour encounters beside it are `astro:assets` crops with build-hashed URLs of their
// own, and the frames behind them are declared where their canonical derivative lives — in the
// archive — rather than claimed twice under two different URLs.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const peopleSchema = [
  // BaseLayout's default WebPage node is replaced once a page supplies schema of its own, so it is
  // restated here rather than lost.
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'People and encounters — Elsewhere', description: 'Encounters, gestures, work, and human presence from the Elsewhere visual archive.', url: canonical },
  breadcrumbs([{ name: 'Elsewhere', path: '/' }, { name: 'People', path: '/people/' }], Astro.site),
  ...[{ photo: craftsperson, alt: peopleEncounterFrame.alt }, ...deeper.map((photo) => ({ photo, alt: photo.alt }))]
    .map(({ photo, alt }, index) => imageObject({ ...photo, altText: alt }, Astro.site, canonical, index === 0)),
];
---

<BaseLayout title="People and encounters — Elsewhere" description="Encounters, gestures, work, and human presence from the Elsewhere visual archive." image="/social/people.jpg" imageAlt="A food vendor works behind a small counter" schema={peopleSchema}>
  <SiteHeader />
  <main id="main" class="people-page">
    <header class="people-hero">
      <div class="people-hero-copy">
        <span class="memory-mark" aria-hidden="true"></span>
        <h1>People I met<br />along the way.</h1>
        <p>Not a directory of portraits. A record of attention: work, movement, conversation, and the brief permission of a photograph.</p>
      </div>
      <Image src={vendor} alt="A food vendor works behind a small counter" widths={[768, 1200, 1800]} sizes="(min-width: 901px) 58vw, 100vw" loading="eager" fetchpriority="high" />
    </header>

    <section class="encounter-sequence" aria-labelledby="encounter-title">
      <header><h2 id="encounter-title">Encounters,<br />not profiles.</h2><p>Names and places will appear only when known and appropriate. Until then, the photograph remains without invented biography.</p></header>
      <figure class="encounter encounter-worker" data-photo-reveal><img src={craftsperson.thumbnail} srcset={`${craftsperson.thumbnail} ${derivativeWidth(craftsperson, 720)}w, ${craftsperson.archiveImage} ${derivativeWidth(craftsperson, 1350)}w`} sizes="(min-width: 901px) 38vw, 88vw" width={craftsperson.width} height={craftsperson.height} alt={peopleEncounterFrame.alt} loading="lazy" decoding="async" /><figcaption>Work{craftsperson.destination ? ` · ${craftsperson.destination}` : ''}</figcaption></figure>
      <figure class="encounter encounter-vendor" data-photo-reveal><Image src={goldenPortrait} alt="A young woman turns towards low evening light" widths={[480, 768, 1200]} sizes="(min-width: 901px) 38vw, 68vw" loading="lazy" /><figcaption>Last light · La Réunion</figcaption></figure>
      <figure class="encounter encounter-motorcycle" data-photo-reveal><Image src={motorcycle} alt="Two people pause beside a motorcycle on a city street" widths={[768, 1200, 1600]} sizes="(min-width: 901px) 54vw, 100vw" loading="lazy" /><figcaption>Between one place and the next</figcaption></figure>
    </section>

    <section class="people-deeper" aria-labelledby="people-deeper-title">
      <header>
        <h2 id="people-deeper-title">Further<br />encounters.</h2>
        <p>Six more, from four countries. Work, movement, waiting — and the moment a stranger allowed a photograph.</p>
      </header>
      <div class="people-deeper-grid">
        {deeper.map((photo) => (
          <figure class={`is-${photo.role}`} data-photo-reveal>
            <img
              src={photo.thumbnail}
              srcset={`${photo.thumbnail} ${derivativeWidth(photo, 960)}w, ${photo.archiveImage} ${derivativeWidth(photo, 1800)}w`}
              sizes={deeperSizes(photo.role)}
              width={photo.width}
              height={photo.height}
              alt={photo.alt}
              loading="lazy"
              decoding="async"
            />
            <figcaption>{photo.note}{photo.destination ? ` · ${photo.destination}` : ''}</figcaption>
          </figure>
        ))}
      </div>
      <a class="editorial-link" href={withBase("/archive/?world=people")} data-analytics-event="archive_open" data-analytics-context="people:world">All {peopleCount} photographs of people <span aria-hidden="true">→</span></a>
    </section>

    <aside class="people-next"><p>Another way through the same archive.</p><a href={withBase("/collections/black-and-white/")}><span>Black &amp; White</span><b aria-hidden="true">→</b></a></aside>
  </main>
  <SiteFooter showContinuation={false} />
</BaseLayout>
