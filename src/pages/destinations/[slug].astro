---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import destinationData from '../../../data/destinations.json';
import catalogData from '../../data/photo-catalog';
import heroPipeline from '../../data/hero-pipeline';
import { imageObject } from '../../data/image-schema';
import { journeyStoryForDestination } from '../../data/journey';
import { absoluteUrl, withBase } from '../../config/paths';

export function getStaticPaths() {
  return destinationData.destinations.filter((destination) => destination.publicationStatus === 'published').map((destination) => ({ params: { slug: destination.slug }, props: { destination } }));
}

const { destination } = Astro.props;
const photosById = new Map(catalogData.photos.map((photo) => [photo.id, photo]));
const orderedIds = [destination.heroPhotoId, ...destination.manualOrder.filter((id) => id !== destination.heroPhotoId)].filter(Boolean);
const sequence = orderedIds.map((id) => photosById.get(id)).filter(Boolean);
const [hero, ...rest] = sequence;
// Sequence roles are namespaced: an unprefixed 'portrait' role would collide with the
// 'is-portrait' orientation class and silently override the layout of every portrait photograph.
const sequenceRoles = ['seq-wide', 'seq-portrait', 'seq-quiet', 'seq-anchor', 'seq-offset', 'seq-closing'];
const sequenceSizes = (role, photo) => {
  if (role === 'seq-anchor') return '(min-width: 1200px) 72vw, (min-width: 561px) 76vw, 100vw';
  if (role === 'seq-wide') return '(min-width: 1200px) 56vw, (min-width: 561px) 68vw, 96vw';
  if (role === 'seq-closing') return '(min-width: 1200px) 54vw, (min-width: 561px) 64vw, 100vw';
  if (photo.orientation === 'portrait') return '(min-width: 1200px) 36vw, (min-width: 561px) 48vw, 78vw';
  return '(min-width: 1200px) 48vw, (min-width: 561px) 58vw, 88vw';
};
const derivativeWidth = (photo, longEdge) => Math.min(photo.width, photo.orientation === 'portrait' ? Math.round(longEdge * photo.width / photo.height) : longEdge);
// Dates and provenance come from the data, never from the template. A destination sourced from the
// owner's travel timeline says so; one dated from capture metadata says that instead.
const formatDate = (value, withYear = true) => new Date(value).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', ...(withYear ? { year: 'numeric' } : {}) });
// The published Journey chapter for this destination, if one exists. The same helper already
// drives the link on /archive/place/<slug>/ for destinations that have no chapter page of their
// own; Japan is the first destination that is both a published chapter and a published Story, so
// the relationship has to exist here too rather than only on the archive route.
const destinationStory = journeyStoryForDestination(destination.id);
const range = destination.dateRange;
const sameYear = range && range.start.slice(0, 4) === range.end.slice(0, 4);
const journey = range ? {
  dates: range.start === range.end ? formatDate(range.start) : `${formatDate(range.start, !sameYear)} — ${formatDate(range.end)}`,
  note: range.source === 'OWNER_TRAVEL_TIMELINE'
    // A region-level chapter has its place confirmed by definition, so the country-only caveat
    // would be untrue there.
    ? (destination.parentDestination
      ? 'Place confirmed by the photographer’s travel record. Individual towns within it are not named.'
      : 'Country confirmed by the photographer’s travel record. Individual cities and regions are not named.')
    // Span is computed from the photographs, so the line stays true for any chapter. A short visit
    // is counted in days and named by its month; a place returned to over a long period is counted
    // in months and named by none, because "276 days in September" would be both absurd and a claim
    // of continuous presence that the photographs do not support.
    : (() => {
      const days = Math.round((Date.parse(range.end) - Date.parse(range.start)) / 86400000) + 1;
      const span = days <= 60
        ? `over ${days} days in ${new Date(range.start).toLocaleDateString('en-GB', { month: 'long' })}`
        : `across ${Math.round(days / 30.44)} months`;
      return `Photographed ${span}. Place confirmed by the photographer; the dates are taken from the photographs themselves.`;
    })(),
} : null;
const altByFilename = {
  'P1230620.jpg': 'A gull approaches a row of outstretched hands above the water.',
  'P1230638.jpg': 'A hand extends beside a rope with churning water below.',
  'P1250177.jpg': 'Dry grasses rise from a roofline beneath a dense field of cloud.',
  'P1250557.jpg': 'Three people wave from a steep hillside dense with green plants.',
  'P1260492.jpg': 'Late light falls across signs and buildings beside an urban canal.',
  'P1230481.jpg': 'Pedestrians moving through a dense street scene with layered signs.',
  'P1230482.jpg': 'A pedestrian passes beneath lanterns and layered street signs.',
  'P1230535.jpg': 'A cyclist crosses a narrow street in low evening sun.',
  'P1230541.jpg': 'Red evening light falls across a compact building facade.',
  'P1230676.jpg': 'Small human figures beside forceful moving water.',
  'P1230826.jpg': 'Two people travel across still water in a small round boat.',
  'P1230865.jpg': 'A whale shark moves through deep blue water.',
  'P1230927.jpg': 'Tall-masted boats wait beside a dark waterfront.',
  'P1230928.jpg': 'A solitary waterfront building beneath a heavy sky.',
  'P1230942.jpg': 'A small stone shelter stands above a rough shoreline.',
  'P1230972.jpg': 'A hand holding a shell in a close, quiet frame.',
  'P1240747.jpg': 'Bands of warm light fall through a dark wooden interior.',
  'P1240787.jpg': 'An orange torii gate stands above a narrow stone stair.',
  'P1260122.jpg': 'A breakwater lighthouse beneath a long grey sky.',
  // Japan, Phase 9.2 re-cut.
  'P1260493.jpg': 'Illuminated signs crowd the front of a canal-side street.',
  'P1260490.jpg': 'Signs and buildings press in along a canal in the last light.',
  'P1260442.jpg': 'A cyclist passes a wall of stickers and spray paint in a narrow lane.',
  'P1240723.jpg': 'A long wooden corridor opens onto light at its far end.',
  'P1260213.jpg': 'Bamboo stems rise close together in low light.',
  'P1230806.jpg': 'Three people cross still water in a small round boat.',
  'P1230855.jpg': 'A man in white stands on black rock above the shore.',
  'P1240051.jpg': 'A performer in a dark hat waits beneath festival ropes.',
  'P1240950-Enhanced-NR.jpg': 'A lighthouse stands above a field of orange flowers.',
  'P1230935-2.jpg': 'A stone shrine stands on a shingle shore beneath heavy cloud.',
  'P1250819.jpg': 'A tall sea stack rises beyond a shore of pale boulders.',
  'P1250632.jpg': 'A footpath runs along a green ridge above the sea.',
  // La Réunion, Phase 9.2 chapter.
  'P1270181.jpg': 'Cloud gathers over the ridges and rock spires of an eroded volcanic cirque.',
  'P1270145.jpg': 'Steep green ridges fall away beneath a bank of low cloud.',
  'P1270434.jpg': 'A dark ravine drops between two forested walls beneath heavy cloud.',
  'P1300247.jpg': 'A stone stairway with a wooden rail climbs into rising mist.',
  'P1280368.jpg': 'Buttressed trunks stand in a dim forest with sea light behind them.',
  'P1280317.jpg': 'A shallow river runs over dark rock between dense green banks.',
  'P1300531.jpg': 'A white dormer window set into a red tile roof above a palm.',
  'P1280794.jpg': 'A pale church spire and its clock face against a bank of cloud.',
  'P1270530.jpg': 'An abandoned house stands with mountains behind it in low cloud.',
  'P1260765.jpg': 'A wave breaks against the breakwater below a lighthouse tower.',
  'P1280067.jpg': 'A wave folds over itself against black volcanic rock.',
  'P1260926.jpg': 'Small figures stand on concrete blocks in a green sea.',
  'P1300638.jpg': 'A surfer carries a board along the shoreline against a pale sky.',
  'P1280221.jpg': 'The moon stands above a breaking wave in the last light.',
  // Düsseldorf, Phase 9.25. No district, street or landmark is named: the owner confirmed the city
  // and nothing more, and a facade is not evidence of an address.
  'P1350974.jpg': 'Red cables run down from the white pylon of a bridge into deep blue sky.',
  'P1310249.jpg': 'A dirt path runs between two rows of old plane trees in autumn.',
  'P1310263.jpg': 'A line of plane trees leans over grass scattered with fallen leaves.',
  'P1310529.jpg': 'Blue-green spruce needles fill the frame.',
  'P1320465.jpg': 'A traffic light hangs in front of an ornate nineteenth-century facade.',
  'P1320543.jpg': 'Church domes and a spire against a hard teal sky.',
  'P1320572.jpg': 'A glass rotunda meets a curved dark facade, with a bird and a small moon above.',
  'P1310315.jpg': 'A concrete tower shaft rises into a deep teal sky.',
  'P1320146.jpg': 'A single lit window in the observation deck of a tower at dusk.',
  'P1370435.jpg': 'A cable-stayed bridge crosses the river under a pink evening sky.',
  'P1320707.jpg': 'Two pale curved walls step against an empty teal sky.',
  'P1320755.jpg': 'A pale curved wall cuts a long arc across cloud.',
  'P1310559-2.jpg': 'A loose formation of geese crosses a bright, clouded sky.',
};
// Chapters with a purpose-made 1200×630 card in public/social use it; anything else falls back to
// its hero derivative, which is a photograph rather than a social card. Keep in step with
// scripts/generate-social-images.py.
const socialCardSlugs = new Set(['japan', 'essaouira', 'la-reunion', 'dusseldorf']);
// Phase 9.27 — the hero is art-directed from the data, never from the template. `hero` carries the
// chosen frame plus its focal point per breakpoint, its scrim strengths and any title correction, so
// the owner can re-crop or re-tune an opening without touching CSS. Absent config falls back to the
// values every chapter used before, which keeps a new destination correct on the day it is created.
const heroArt = destination.hero ?? {};
const heroFocal = { desktop: '50% 56%', tablet: '50% 56%', mobile: '48% 50%', ...(heroArt.focal ?? {}) };
const heroScrim = { top: 0.72, bottom: 0.74, bottomStart: 50, ...(heroArt.overlay ?? {}) };
const heroStyle = [
  `--hero-focal:${heroFocal.desktop}`,
  `--hero-focal-tablet:${heroFocal.tablet}`,
  `--hero-focal-mobile:${heroFocal.mobile}`,
  `--hero-scrim-top:${heroScrim.top}`,
  `--hero-scrim-bottom:${heroScrim.bottom}`,
  `--hero-scrim-start:${heroScrim.bottomStart}%`,
  `--hero-title-scale:${heroArt.titleScale ?? 1}`,
].join(';');
// A full-bleed `object-fit: cover` box renders the photograph wider than the viewport whenever the
// image is less tall than the screen: a landscape frame on a tall phone paints roughly three times
// the screen width, a portrait frame about 1.6 times. `sizes` therefore describes that painted width,
// not the layout width — 100vw would under-request by a factor of three and deliver a soft hero.
//
// The values are deliberately below the widest case. Matching a 3× phone exactly would mean shipping
// the 2560px file (0.9 MB) to paint a backdrop that is cropped and half-covered by a scrim; these
// land a 2× phone on 1536 and a 3× phone on 2048, which is sharp in the hand and roughly a quarter of
// the 2.1–2.4 MB viewer file this replaced.
const heroSources = heroPipeline.heroes?.[destination.slug] ?? null;
const heroSrcset = heroSources?.sources.map((source) => `${source.url} ${source.width}w`).join(', ');
const heroSizes = '(max-width: 560px) 165vw, (max-width: 900px) 150vw, 100vw';
const heroLargest = heroSources?.sources.at(-1);
// A week somewhere is travel. Nine months of returning to the same city is not, and calling it
// "travel photography" would be untrue. The discriminator is the span the photographs themselves
// describe — the same signal the provenance line uses — not the journey register, which predates
// some genuine trips.
const spanDays = range ? Math.round((Date.parse(range.end) - Date.parse(range.start)) / 86400000) + 1 : 0;
const chapterTitle = spanDays > 60 && !destination.journeyIds?.length
  ? (destination.seoTitle ?? `${destination.name} photographs — Elsewhere`)
  : `${destination.name} travel photography — Elsewhere`;
const canonicalPath = `/destinations/${destination.slug}/`;
const destinationSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'CollectionPage', name: `${destination.name} photographs`, description: `A confirmed photographic chapter from ${destination.name}, edited from the Elsewhere archive.`, url: absoluteUrl(canonicalPath, Astro.site), primaryImageOfPage: { '@type': 'ImageObject', contentUrl: new URL(hero.viewerImage, Astro.site).href } },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Elsewhere', item: absoluteUrl('/', Astro.site) },
      { '@type': 'ListItem', position: 2, name: 'Destinations', item: absoluteUrl('/destinations/', Astro.site) },
      { '@type': 'ListItem', position: 3, name: destination.name, item: absoluteUrl(canonicalPath, Astro.site) },
    ] },
    // Every photograph rendered on this page, with truthful credit, copyright and
    // (where the frame's rights state allows an enquiry) a place to ask about using it.
    ...sequence.map((photo, index) => imageObject(photo, Astro.site, absoluteUrl(canonicalPath, Astro.site), index === 0)),
  ],
};
---

<BaseLayout title={chapterTitle} description={`A confirmed photographic chapter from ${destination.name}, edited from the Elsewhere archive.`} image={socialCardSlugs.has(destination.slug) ? `/social/${destination.slug}.jpg` : hero.archiveImage} imageAlt={altByFilename[hero.filename] ?? hero.altText} schema={destinationSchema}>
  <SiteHeader />
  <main id="main" class="destination-chapter">
    <header class="destination-hero" style={heroStyle}>
      <img src={heroLargest?.url ?? hero.viewerImage} srcset={heroSrcset} sizes={heroSrcset ? heroSizes : undefined} width={hero.width} height={hero.height} alt={altByFilename[hero.filename] ?? hero.altText} loading="eager" fetchpriority="high" />
      <div class="destination-hero-title"><span class="memory-mark"></span><h1>{destination.name}</h1>{destination.parentDestination && <p class="destination-country">{destination.country}</p>}<p>{journey?.dates}</p></div>
    </header>
    {/* The provenance note and the registered-photograph count are both publication-system copy:
        one describes how confidently the place is known, the other how many rows the chapter drew
        from. Neither is something a visitor came to read, so neither is emitted. The band survives
        only when it has a real destination — the link into the Journey chapter. */}
    {(destination.photographicIndex || destinationStory) && (
      <section class="destination-chapter-link" aria-label={`${destination.name} photographic body`}>
        {destination.photographicIndex && <p>{destination.photographicIndex}</p>}
        {destinationStory && (
        <a class="editorial-link" href={withBase(`/journey/${destinationStory.slug}/`)} data-analytics-event="journey_open" data-analytics-context={`destination:${destination.slug}`}>
          Read the story <span aria-hidden="true">→</span>
        </a>
        )}
      </section>
    )}
    <section class="destination-sequence" aria-label={`Selected photographs from ${destination.name}`}>
      {rest.map((photo, index) => {
        const role = sequenceRoles[index % sequenceRoles.length];
        return (
        <figure class:list={['destination-frame', `is-${role}`, `is-${photo.orientation}`]} data-photo-reveal>
          <img src={photo.thumbnail} srcset={`${photo.thumbnail} ${derivativeWidth(photo, 960)}w, ${photo.archiveImage} ${derivativeWidth(photo, 1800)}w, ${photo.viewerImage} ${derivativeWidth(photo, 3200)}w`} sizes={index === rest.length - 1 ? '(min-width: 1200px) 72vw, (min-width: 561px) 78vw, 100vw' : sequenceSizes(role, photo)} width={photo.width} height={photo.height} loading="lazy" decoding="async" alt={altByFilename[photo.filename] ?? photo.altText} />
          {/* Sequence number and year only. `visualWorlds` is an internal curatorial facet
              (`visualWorldConfidence: CURATORIAL_ASSIGNMENT`) that drives archive filtering; printed
              under a photograph it read as a database record attached to the picture — "2025 · ocean,
              people" — rather than as a caption anyone wrote. Authored captions live in the Story
              data, where a human decides them. */}
          <figcaption><span>{String(index + 2).padStart(2, '0')}</span><p>{photo.year}</p></figcaption>
        </figure>
        );
      })}
    </section>
    <aside class="destination-continuation">
      <p>The {destination.name} body continues beyond this edit.</p>
      <a href={withBase(`/archive/?destination=${destination.slug}`)} data-analytics-event="archive_open" data-analytics-context={`destination:${destination.slug}`}><span>Continue through {destination.name}</span><b aria-hidden="true">→</b></a>
      <a href={withBase("/collections/black-and-white/")} data-analytics-event="black_white_open" data-analytics-context={`destination:${destination.slug}`}>Enter Black &amp; White</a>
    </aside>
  </main>
  <SiteFooter showContinuation={false} />
</BaseLayout>
