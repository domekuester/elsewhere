---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import destinationData from '../../../data/destinations.json';
import catalogData from '../../../public/data/photo-catalog.json';
import { imageObject } from '../../data/image-schema';

export function getStaticPaths() {
  return destinationData.destinations.filter((destination) => destination.publicationStatus === 'published').map((destination) => ({ params: { slug: destination.slug }, props: { destination } }));
}

const { destination } = Astro.props;
const photosById = new Map(catalogData.photos.map((photo) => [photo.id, photo]));
const orderedIds = [destination.heroPhotoId, ...destination.manualOrder.filter((id) => id !== destination.heroPhotoId)].filter(Boolean);
const sequence = orderedIds.map((id) => photosById.get(id)).filter(Boolean);
const [hero, ...rest] = sequence;
// Sequence roles are namespaced: an unprefixed 'portrait' role would collide with the
// 'is-portrait' orientation class and silently override the layout of every portrait photograph.
const sequenceRoles = ['seq-wide', 'seq-portrait', 'seq-quiet', 'seq-anchor', 'seq-offset', 'seq-closing'];
const derivativeWidth = (photo, longEdge) => Math.min(photo.width, photo.orientation === 'portrait' ? Math.round(longEdge * photo.width / photo.height) : longEdge);
// Dates and provenance come from the data, never from the template. A destination sourced from the
// owner's travel timeline says so; one dated from capture metadata says that instead.
const formatDate = (value, withYear = true) => new Date(value).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', ...(withYear ? { year: 'numeric' } : {}) });
const range = destination.dateRange;
const sameYear = range && range.start.slice(0, 4) === range.end.slice(0, 4);
const journey = range ? {
  dates: range.start === range.end ? formatDate(range.start) : `${formatDate(range.start, !sameYear)} — ${formatDate(range.end)}`,
  note: range.source === 'OWNER_TRAVEL_TIMELINE'
    ? 'Country confirmed by the owner’s travel timeline. Cities and regions remain intentionally unassigned.'
    // Span and month are computed from the photographs, so the line stays true for any chapter.
    : `Photographed over ${Math.round((Date.parse(range.end) - Date.parse(range.start)) / 86400000) + 1} days in ${new Date(range.start).toLocaleDateString('en-GB', { month: 'long' })}. Place confirmed by the photographer; the dates are taken from the photographs themselves.`,
} : null;
const altByFilename = {
  'P1230620.jpg': 'A gull approaches a row of outstretched hands above the water.',
  'P1230638.jpg': 'A hand extends beside a rope with churning water below.',
  'P1250177.jpg': 'Dry grasses rise from a roofline beneath a dense field of cloud.',
  'P1250557.jpg': 'Three people wave from a steep hillside dense with green plants.',
  'P1260492.jpg': 'Late light falls across signs and buildings beside an urban canal.',
  'P1230481.jpg': 'Pedestrians moving through a dense street scene with layered signs.',
  'P1230482.jpg': 'A pedestrian passes beneath lanterns and layered street signs.',
  'P1230535.jpg': 'A cyclist crosses a narrow street in low evening sun.',
  'P1230541.jpg': 'Red evening light falls across a compact building facade.',
  'P1230676.jpg': 'Small human figures beside forceful moving water.',
  'P1230826.jpg': 'Two people travel across still water in a small round boat.',
  'P1230865.jpg': 'A whale shark moves through deep blue water.',
  'P1230927.jpg': 'Tall-masted boats wait beside a dark waterfront.',
  'P1230928.jpg': 'A solitary waterfront building beneath a heavy sky.',
  'P1230942.jpg': 'A small stone shelter stands above a rough shoreline.',
  'P1230972.jpg': 'A hand holding a shell in a close, quiet frame.',
  'P1240747.jpg': 'Bands of warm light fall through a dark wooden interior.',
  'P1240787.jpg': 'An orange torii gate stands above a narrow stone stair.',
  'P1260122.jpg': 'A breakwater lighthouse beneath a long grey sky.',
};
const canonicalPath = `/destinations/${destination.slug}/`;
const destinationSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'CollectionPage', name: `${destination.name} photographs`, description: `A confirmed photographic chapter from ${destination.name}, edited from the Elsewhere archive.`, url: new URL(canonicalPath, Astro.site).href, primaryImageOfPage: { '@type': 'ImageObject', contentUrl: new URL(hero.viewerImage, Astro.site).href } },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Elsewhere', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Destinations', item: new URL('/destinations/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: destination.name, item: new URL(canonicalPath, Astro.site).href },
    ] },
    // Every photograph rendered on this page, with truthful credit, copyright and
    // (where the frame's rights state allows an enquiry) a place to ask about using it.
    ...sequence.map((photo, index) => imageObject(photo, Astro.site, new URL(canonicalPath, Astro.site).href, index === 0)),
  ],
};
---

<BaseLayout title={`${destination.name} travel photography — Elsewhere`} description={`A confirmed photographic chapter from ${destination.name}, edited from the Elsewhere archive.`} image={['japan', 'essaouira'].includes(destination.slug) ? `/social/${destination.slug}.jpg` : hero.archiveImage} imageAlt={altByFilename[hero.filename] ?? hero.altText} schema={destinationSchema}>
  <SiteHeader />
  <main id="main" class="destination-chapter">
    <header class="destination-hero">
      <img src={hero.viewerImage} width={hero.width} height={hero.height} alt={altByFilename[hero.filename] ?? hero.altText} loading="eager" fetchpriority="high" />
      <div class="destination-hero-title"><span class="memory-mark"></span><h1>{destination.name}</h1>{destination.parentDestination && <p class="destination-country">{destination.country}</p>}<p>{journey?.dates}</p></div>
    </header>
    <section class="destination-provenance">
      <p>{journey?.note}</p>
      <p>{destination.confirmedPhotoCount} photographs belong to this {destination.parentDestination ? 'place' : 'destination period'}. This chapter is a curated passage through them.</p>
    </section>
    <section class="destination-sequence" aria-label={`Selected photographs from ${destination.name}`}>
      {rest.map((photo, index) => (
        <figure class:list={['destination-frame', `is-${sequenceRoles[index % sequenceRoles.length]}`, `is-${photo.orientation}`]} data-photo-reveal>
          <img src={photo.thumbnail} srcset={`${photo.thumbnail} ${derivativeWidth(photo, 960)}w, ${photo.archiveImage} ${derivativeWidth(photo, 1800)}w, ${photo.viewerImage} ${derivativeWidth(photo, 3200)}w`} sizes="(min-width: 1200px) 58vw, (min-width: 561px) 66vw, 88vw" width={photo.width} height={photo.height} loading="lazy" decoding="async" alt={altByFilename[photo.filename] ?? photo.altText} />
          <figcaption><span>{String(index + 2).padStart(2, '0')}</span><p>{photo.year}{photo.visualWorlds.length ? ` · ${photo.visualWorlds.map((world) => world.replaceAll('-', ' ')).join(', ')}` : ''}</p></figcaption>
        </figure>
      ))}
    </section>
    <aside class="destination-continuation">
      <p>The chapter continues through the deeper archive.</p>
      <a href={`/archive/?destination=${destination.slug}`} data-analytics-event="archive_open" data-analytics-context={`destination:${destination.slug}`}><span>Continue in the archive</span><b aria-hidden="true">→</b></a>
      <a href="/collections/black-and-white/" data-analytics-event="black_white_open" data-analytics-context={`destination:${destination.slug}`}>Enter Black &amp; White</a>
    </aside>
  </main>
  <SiteFooter />
</BaseLayout>
