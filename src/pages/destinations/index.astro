---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import destinationData from '../../../data/destinations.json';
import catalogData from '../../data/photo-catalog';
import { imageObject, breadcrumbs } from '../../data/image-schema';
import { withBase } from '../../config/paths';

// Ordered by archive depth rather than alphabetically, which is how the index has always read.
// Open chapters are lifted out of the list into a photographic layer: with more than one of them,
// a row of text no longer does the work of an entrance.
const photosById = new Map(catalogData.photos.map((photo) => [photo.id, photo]));
const ranked = destinationData.destinations
  .filter((destination) => destination.confirmedPhotoCount > 0)
  .sort((a, b) => b.confirmedPhotoCount - a.confirmedPhotoCount);
const chapters = ranked.filter((destination) => destination.publicationStatus === 'published');
const inProgress = ranked.filter((destination) => destination.publicationStatus !== 'published');
const derivativeWidth = (photo, longEdge) => Math.min(photo.width, photo.orientation === 'portrait' ? Math.round(longEdge * photo.width / photo.height) : longEdge);
const year = (destination) => destination.dateRange?.end.slice(0, 4) ?? null;
// Each open chapter leads on a real archive derivative — the thumbnail is the `src`, the archive
// file sits in the same `srcset` — so those frames are indexable photographs on this page and
// carry the same credit, copyright and licensing metadata they carry anywhere else. The
// in-progress rows are text, and claim nothing.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const chapterHeroes = chapters.map((destination) => photosById.get(destination.heroPhotoId)).filter(Boolean);
const destinationsSchema = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Travel photography destinations — Elsewhere', description: 'Photographic chapters from Japan, La Réunion and Essaouira, Morocco, with Malaysia, Thailand, Phu Quoc and Laos held in the archive.', url: canonical },
  breadcrumbs([{ name: 'Elsewhere', path: '/' }, { name: 'Destinations', path: '/destinations/' }], Astro.site),
  ...chapterHeroes.map((photo, index) => imageObject(photo, Astro.site, canonical, index === 0)),
];
---

<BaseLayout
  title="Travel photography destinations — Elsewhere"
  description="Photographic chapters from Japan, La Réunion and Essaouira, Morocco, with Malaysia, Thailand, Phu Quoc and Laos held in the archive."
  image="/social/japan.jpg"
  imageAlt="A gull approaches a row of outstretched hands above the water"
  schema={destinationsSchema}
>
  <SiteHeader />
  <main id="main" class="index-page">
    <header class="index-intro">
      <span class="memory-mark" aria-hidden="true"></span>
      <p>Place index</p>
      <h1>Destinations</h1>
      <div>
        <p>Places are named only where the photographer has confirmed them. Everything else stays in the archive, unassigned, until it is known.</p>
        <a class="editorial-link" href={withBase("/archive/")}>Explore the photographic index <span aria-hidden="true">→</span></a>
      </div>
    </header>

    <section class="chapter-entries" aria-label="Open chapters">
      {chapters.map((destination, index) => {
        const hero = photosById.get(destination.heroPhotoId);
        // The chapters arrive sorted by archive depth, so the first is the deepest body of work and
        // takes the full-width lead plate; the rest hang beneath it as a descending suite. The lead
        // is drawn at the width of the page and needs the derivative to match, or the one
        // photograph the index leads on is the one it serves softest. `40vw` is the widest plate
        // the suite now draws rather than the old uniform third, so the largest of them stops being
        // served a derivative sized for the smallest.
        const isLead = index === 0;
        return (
          <a class="chapter-entry" href={withBase(`/destinations/${destination.slug}/`)} data-analytics-event="destination_open" data-analytics-context={`index:${destination.slug}`}>
            <span class="chapter-entry-image">
              {hero && (
                <img
                  src={hero.thumbnail}
                  srcset={isLead
                    ? `${hero.thumbnail} ${derivativeWidth(hero, 960)}w, ${hero.archiveImage} ${derivativeWidth(hero, 1800)}w, ${hero.viewerImage} ${derivativeWidth(hero, 3200)}w`
                    : `${hero.thumbnail} ${derivativeWidth(hero, 960)}w, ${hero.archiveImage} ${derivativeWidth(hero, 1800)}w`}
                  sizes={isLead ? '(min-width: 901px) 94vw, 100vw' : '(min-width: 901px) 40vw, 100vw'}
                  width={hero.width}
                  height={hero.height}
                  alt={hero.altText}
                  loading={isLead ? 'eager' : 'lazy'}
                  decoding="async"
                />
              )}
            </span>
            <span class="chapter-entry-copy">
              <span class="folio folio-plate">{String(index + 1).padStart(2, '0')}</span>
              <b>{destination.name}</b>
              <i aria-hidden="true">↗</i>
              {destination.parentDestination && <em>{destination.country}</em>}
              <small>{destination.confirmedPhotoCount} photographs{year(destination) ? ` · ${year(destination)}` : ''}</small>
            </span>
          </a>
        );
      })}
    </section>

    <section class="index-rest" aria-labelledby="index-rest-title">
      <h2 id="index-rest-title">In the archive</h2>
      <ol class="index-list">
        {inProgress.map((destination, index) => (
          <li>
            <span class="folio folio-plate">{String(index + 1).padStart(2, '0')}</span>
            {/* A named place with a real photograph count must lead somewhere. Without a chapter,
                that somewhere is the archive addressed to it: /archive/place/<slug>/, which opens on a
                photograph from that place rather than on the Archive's own frame. */}
            <a href={withBase(`/archive/place/${destination.slug}/`)} data-analytics-event="archive_open" data-analytics-context={`destinations:${destination.slug}`}><strong>{destination.name}</strong></a>
            <small>{destination.confirmedPhotoCount} photographs</small>
          </li>
        ))}
      </ol>
      <a class="editorial-link" href={withBase("/archive/")} data-analytics-event="archive_open" data-analytics-context="destinations">Every photograph, by place and year <span aria-hidden="true">→</span></a>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
