---

import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import EnquiryAction from '../components/EnquiryAction.astro';
import { business, site } from '../config/site';
import catalogData from '../data/photo-catalog';
import { absoluteUrl, withBase } from '../config/paths';

// Studio was built entirely from Home's photographs, so a professional who scrolled the homepage
// and then opened Studio met the same four pictures again — the weakest possible argument from a
// page whose claim is "this site is the portfolio". These four appear nowhere else on the site.
const studioFrames = new Map([
  ['photo-0249', 'A coastal road curves around a green headland above the sea.'],
  ['photo-0001', 'Two people work behind the counter of a small, warmly lit kitchen.'],
  ['photo-0339', 'Low evening light crosses a tatami room with dark seating.'],
  ['photo-0347', 'An empty street corner beneath a pale morning sky.'],
]);
const frame = (id) => {
  const photo = catalogData.photos.find((item) => item.id === id);
  if (!photo?.public) throw new Error(`Studio references ${id}, which is not a public photograph.`);
  return { ...photo, alt: studioFrames.get(id) };
};
const [studioHero, studioOffer, studioProofA, studioProofB] = [...studioFrames.keys()].map(frame);
const derivativeWidth = (photo, longEdge) => Math.min(photo.width, photo.orientation === 'portrait' ? Math.round(longEdge * photo.width / photo.height) : longEdge);

// Three offerings, no more. Every claim on this page is about capability, never about
// clients, awards, or projects that do not exist.
const services = [
  {
    number: '01',
    title: 'Photography',
    lede: 'Places, people, rooms, food, weather, work.',
    body: 'Photographed on location: rooms, food, interiors, and the people working in them where they are happy to be photographed. Delivered edited.',
    detail: ['Hotels, restaurants and interiors', 'Travel and destination', 'People at work', 'Food and product in context', 'Editorial documentation'],
  },
  {
    number: '02',
    title: 'Editing',
    lede: 'Working out which ones.',
    body: 'A shoot produces far more photographs than anyone needs. Deciding which ones to use, and in what order, is most of the work. It is what I did to every page here.',
    detail: ['Image selection and edit', 'Editorial sequencing', 'Campaign and location narrative', 'Visual identity through photography', 'Art direction for a shoot'],
  },
  {
    number: '03',
    title: 'Websites',
    lede: 'Built around the photographs.',
    body: 'Sites where the photographs are the main thing rather than something dropped in at the end. Fast, accessible, and built rather than assembled from a template. I made this one.',
    detail: ['Hospitality and restaurant sites', 'Portfolio and publication sites', 'Photographic archives and galleries', 'Performance and accessibility work', 'Design and build end to end'],
  },
];

const studioSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Elsewhere Studio',
  description: 'Commissioned photography, editing, and the websites the photographs go on.',
  url: absoluteUrl('/studio/', Astro.site),
  parentOrganization: { '@type': 'Organization', name: site.name, url: absoluteUrl('/', Astro.site) },
  serviceType: ['Photography', 'Photo editing and sequencing', 'Web design and development'],
  ...(business.enquiriesEnabled ? { email: business.contactEmail } : {}),
};
---

<BaseLayout
  title="Elsewhere Studio — photography, editing and websites"
  description="Commissioned photography, editing, and the websites the photographs go on."
  image="/social/studio.jpg"
  imageAlt="Deep green ridges beneath a gathering field of clouds"
  schema={studioSchema}
>
  <SiteHeader />
  <main id="main" class="studio-page">
    <header class="studio-hero">
      <div class="studio-hero-media">
        <img src={studioHero.archiveImage} srcset={`${studioHero.archiveImage} ${derivativeWidth(studioHero, 1800)}w, ${studioHero.viewerImage} ${derivativeWidth(studioHero, 3200)}w`} sizes="100vw" width={studioHero.width} height={studioHero.height} alt="" loading="eager" fetchpriority="high" decoding="async" />
      </div>
      <span class="memory-mark" aria-hidden="true"></span>
      <p class="studio-kicker">Elsewhere Studio</p>
      <h1>Photography.<br />Editing.<br />Websites.</h1>
      <p class="studio-lede">Three things I do for other people.</p>
    </header>

    <section class="studio-premise" aria-label="Studio premise">
      <p>The work does not change much<br />when somebody else pays for it.</p>
      <p>Turn up, photograph the place, come back with something that holds up in print and on a screen. If the site the photographs go on needs building too, I can do that part as well.</p>
    </section>

    <section class="studio-services" aria-labelledby="studio-services-title">
      <h2 id="studio-services-title" class="visually-hidden">What the studio does</h2>
      {services.map((service) => (
        <article class="studio-service">
          <p class="studio-service-number" aria-hidden="true">{service.number}</p>
          <div class="studio-service-head">
            <h3>{service.title}</h3>
            <p class="studio-service-lede">{service.lede}</p>
          </div>
          <div class="studio-service-body">
            <p>{service.body}</p>
            <ul>{service.detail.map((item) => <li>{item}</li>)}</ul>
          </div>
        </article>
      ))}
    </section>

    <section class="studio-offer" aria-labelledby="studio-offer-title">
      <figure data-photo-reveal>
        <img src={studioOffer.thumbnail} srcset={`${studioOffer.thumbnail} ${derivativeWidth(studioOffer, 960)}w, ${studioOffer.archiveImage} ${derivativeWidth(studioOffer, 1800)}w`} sizes="(min-width: 901px) 52vw, 100vw" width={studioOffer.width} height={studioOffer.height} alt={studioOffer.alt} loading="lazy" decoding="async" />
      </figure>
      <div>
        <span class="memory-mark" aria-hidden="true"></span>
        <p class="studio-kicker">The full commission</p>
        <h2 id="studio-offer-title">Story<br />&amp; Site.</h2>
        <p>New photographs, the edit, and the site they go on, as one job instead of three.</p>
        <p>It is mainly a practical thing. When the same person takes the pictures, chooses them and builds the page, the pictures decide the layout rather than the other way round.</p>
        <p class="studio-note">Scope and cost are quoted per project. There is no package price, because there is no standard project.</p>
      </div>
    </section>

    <section class="studio-proof" aria-labelledby="studio-proof-title">
      <div class="studio-proof-copy">
        <span class="memory-mark" aria-hidden="true"></span>
        <h2 id="studio-proof-title">This site is<br />the portfolio.</h2>
        <p>Everything here was photographed on location, and I built the pages as well. The archive, the viewer, the destination chapters and Black &amp; White are the sample.</p>
        <p class="prose-links">
          <a class="editorial-link" href={withBase("/archive/")} data-analytics-event="archive_open" data-analytics-context="studio">The archive <span aria-hidden="true">→</span></a>
          <a class="editorial-link" href={withBase("/destinations/japan/")} data-analytics-event="destination_open" data-analytics-context="studio:japan">A destination chapter <span aria-hidden="true">→</span></a>
          <a class="editorial-link" href={withBase("/collections/black-and-white/")} data-analytics-event="black_white_open" data-analytics-context="studio">Black &amp; White <span aria-hidden="true">→</span></a>
        </p>
      </div>
      <div class="studio-proof-grid">
        {[studioProofA, studioProofB].map((photo) => (
          <figure data-photo-reveal><img src={photo.thumbnail} srcset={`${photo.thumbnail} ${derivativeWidth(photo, 960)}w, ${photo.archiveImage} ${derivativeWidth(photo, 1800)}w`} sizes="(min-width: 901px) 26vw, 46vw" width={photo.width} height={photo.height} alt={photo.alt} loading="lazy" decoding="async" /></figure>
        ))}
      </div>
    </section>

    {business.enquiriesEnabled && (
      <section class="studio-cta" aria-labelledby="studio-cta-title">
        <h2 id="studio-cta-title">Start a project</h2>
        <p>Tell me where it is, what it is, and roughly when. A short message is enough to begin.</p>
        <EnquiryAction type="studio" label="Discuss a project" context="studio" class="is-large" />
      </section>
    )}
  </main>
  <SiteFooter />
</BaseLayout>
