---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import EnquiryAction from '../components/EnquiryAction.astro';
import { business } from '../config/site';
import catalogData from '../data/photo-catalog';
import destinationData from '../../data/destinations.json';
// About shared its lead photograph with Home's environment section and, until this phase, with the
// Studio hero as well.
const aboutFrame = (() => {
  const photo = catalogData.photos.find((item) => item.id === 'photo-0305');
  if (!photo?.public) throw new Error('About references photo-0305, which is not a public photograph.');
  return photo;
})();
const aboutDerivativeWidth = (photo, longEdge) => Math.min(photo.width, photo.orientation === 'portrait' ? Math.round(longEdge * photo.width / photo.height) : longEdge);
import handShell from '../assets/photos/hand-shell.jpg';
import { withBase } from '../config/paths';

// Every number on this page is read from the archive rather than written by hand.
const publicPhotographs = catalogData.count;
const countries = [...new Set(destinationData.destinations.filter((destination) => destination.confirmedPhotoCount > 0).map((destination) => destination.country))];
const years = [...new Set(catalogData.photos.map((photo) => photo.year).filter(Boolean))].sort();
const span = `${years[0]}—${years.at(-1) === new Date().getFullYear() ? 'ongoing' : years.at(-1)}`;
---

<BaseLayout
  title="About Elsewhere"
  description="Why this archive exists, how it is edited, and how to work with the photographer behind it."
  image="/social/about.jpg"
  imageAlt="Deep green ridges beneath a gathering field of clouds"
>
  <SiteHeader />
  <main id="main" class="prose-page">
    <header class="prose-hero">
      <span class="memory-mark" aria-hidden="true"></span>
      <p class="prose-kicker">About</p>
      <h1>Long enough<br />to be ordinary.</h1>
      <p class="prose-lede">For years I travelled and took photographs on the side. In 2024 I started carrying a real camera, and stopped where I used to keep walking. That is more or less how this started.</p>
    </header>

    <section class="prose-body" aria-label="About the publication">
      <div class="prose-column">
        <h2>Why it exists</h2>
        <p>Most of these photographs were taken while doing something else. Working a reception desk, carrying boats into the water, waiting for better weather, riding to the supermarket. I usually stay somewhere long enough that it stops being an event, and most of what is here comes from that part of it.</p>
        <p>It is not a guide. Some of it is the obvious places, because I went to them like everybody else. Most of it is not.</p>

        <h2>How it is edited</h2>
        <p>The Archive is everything I thought was worth keeping. Home, the destination chapters and the collections are a much smaller edit, put in order by hand.</p>
        <p>Places are named only where I actually know them. Where the record is thin, a photograph stays unassigned rather than guessed at. Anything I have taken down stays down.</p>

        <h2>What is here</h2>
        <p><strong>{publicPhotographs}</strong> published photographs, {span}, from {countries.length} countries. There are more behind them, still being gone through.</p>
      </div>

      <figure class="prose-figure" data-photo-reveal>
        <img src={aboutFrame.thumbnail} srcset={`${aboutFrame.thumbnail} ${aboutDerivativeWidth(aboutFrame, 960)}w, ${aboutFrame.archiveImage} ${aboutDerivativeWidth(aboutFrame, 1800)}w`} sizes="(min-width: 901px) 34vw, 84vw" width={aboutFrame.width} height={aboutFrame.height} alt="A stack of balanced stones on a shore of pale boulders." loading="lazy" decoding="async" />
        <figcaption>Somebody stacked these</figcaption>
      </figure>
    </section>

    <section class="prose-aside" aria-labelledby="about-work-title">
      <figure data-photo-reveal>
        <Image src={handShell} alt="A small spiral shell resting in an open hand" widths={[480, 768, 1200]} sizes="(min-width: 901px) 40vw, 88vw" loading="lazy" />
      </figure>
      <div>
        <span class="memory-mark" aria-hidden="true"></span>
        <h2 id="about-work-title">If you need<br />photographs.</h2>
        <p>I also take commissions, and build the sites the photographs end up on. That side of it lives in the Studio.</p>
        <p>Individual frames from the archive can be licensed. What is possible depends on the photograph, so it is answered one at a time.</p>
        <p class="prose-links">
          <a class="editorial-link" href={withBase("/studio/")} data-analytics-event="studio_open" data-analytics-context="about">Elsewhere Studio <span aria-hidden="true">→</span></a>
          <a class="editorial-link" href={withBase("/licensing/")} data-analytics-event="licensing_open" data-analytics-context="about">Licensing <span aria-hidden="true">→</span></a>
        </p>
      </div>
    </section>

    {business.enquiriesEnabled && (
      <section class="prose-contact" aria-labelledby="about-contact-title">
        <h2 id="about-contact-title">Write to me</h2>
        <p>Commissions, licensing, editorial requests, print interest. It all reaches the same inbox, and a short message is fine.</p>
        <EnquiryAction type="studio" label="Start a conversation" context="about" class="is-large" />
      </section>
    )}
  </main>
  <SiteFooter />
</BaseLayout>
