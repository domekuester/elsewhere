{
  "name": "elsewhere",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "npm run validate:content && npm run validate:exclusions && ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/finalize-production-build.mjs && node scripts/verify-owner-photo-exclusions.mjs --built && npm run validate:launch",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "content:classify": "node scripts/classify-owner-timeline.mjs && node scripts/build-photo-catalog.mjs",
    "audit:images": "python3 scripts/audit-image-duplicates.py",
    "repair:images": "python3 scripts/repair-black-derivatives.py",
    "social:images": "python3 scripts/generate-social-images.py",
    "images:derive": "node scripts/generate-archive-derivatives.mjs && node scripts/build-photo-catalog.mjs",
    "images:repair-inventory": "node scripts/repair-inventory-dimensions.mjs && node scripts/build-photo-catalog.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:exclusions": "node scripts/verify-owner-photo-exclusions.mjs",
    "validate:launch": "node scripts/validate-launch.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^7.2.0",
    "exifr": "^7.1.3",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "sharp": "^0.35.3"
  }
}
